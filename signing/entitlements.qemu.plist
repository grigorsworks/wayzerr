<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  For the bots' computer engine: qemu-system-aarch64 (and qemu-img needs nothing).
  src/computer.js:420 starts QEMU with "-accel hvf" = Apple's Hypervisor.framework.
  The entitlement for that is com.apple.security.hypervisor, and it must be on the QEMU binary itself.
  (com.apple.security.virtualization is for Apple's Virtualization.framework, which QEMU does not use.)
  The engine you ship today already has this key (ad-hoc signed); keep it when you re-sign with Developer ID.

  Sign with:
    codesign --force --timestamp --options runtime \
      --entitlements build/entitlements.qemu.plist \
      --sign "Developer ID Application: YOUR NAME (TEAMID)" engine/bin/qemu-system-aarch64
  Sign engine/lib/libslirp.0.dylib (and any other dylib it loads) with the SAME identity first.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.hypervisor</key>
  <true/>
</dict>
</plist>
