{
  "name": "wayzerr-app",
  "version": "1.3.31",
  "description": "Wayzerr — AI bots with their own personalities, memory, browser and tools",
  "main": "src/main.js",
  "author": "Svetlana",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "jsqr": "^1.4.0",
    "node-forge": "^1.3.1",
    "npm": "^12.1.0",
    "qrcode": "^1.5.4"
  },
  "productName": "Wayzerr",
  "updateFeed": "https://github.com/grigorsworks/persona/releases/latest/download/latest.json",
  "updateFeedBackup": "https://nexarium.netlify.app/latest.json",
  "updateFeedCloud": "https://wayzerr.com/latest.json",
  "accountUrl": "https://wayzerr.com",
  "build": {
    "appId": "com.persona.app",
    "productName": "Wayzerr",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/npm/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "extendInfo": {
        "PersonaNotes": "Wayzerr no longer asks for permission to your Downloads folder every time it updates. | A calmer violet look and a slightly bigger normal text size. | The chat now uses the full width, and you can collapse the bot list to just the faces with the button at the bottom of the sidebar. | Calendar: bots are listed on the left. Add a task for the bot you are chatting with, or drag any bot onto a day or time to give it a task there. The calendar is also in your account menu now; Passwords and Delete account moved out of it (they are still in Settings). | You can see where a chat was compressed, and click “is thinking…” to see what a bot is thinking. | Bots begin a task with “ok, I’ll start with…” instead of “Plan:”, and have some new little animations. | Windows: the computer offer just asks Download or Don’t download (you can download it later in Settings → Computer), and the speed tip has an OK button.",
        "NSMicrophoneUsageDescription": "Wayzerr uses the microphone when you talk to your bots (speech to text).",
        "WayzerrNotes": "Wayzerr no longer asks for permission to your Downloads folder every time it updates. | A calmer violet look and a slightly bigger normal text size. | The chat now uses the full width, and you can collapse the bot list to just the faces with the button at the bottom of the sidebar. | Calendar: bots are listed on the left. Add a task for the bot you are chatting with, or drag any bot onto a day or time to give it a task there. The calendar is also in your account menu now; Passwords and Delete account moved out of it (they are still in Settings). | You can see where a chat was compressed, and click “is thinking…” to see what a bot is thinking. | Bots begin a task with “ok, I’ll start with…” instead of “Plan:”, and have some new little animations. | Windows: the computer offer just asks Download or Don’t download (you can download it later in Settings → Computer), and the speed tip has an OK button.",
        "NSAppleEventsUsageDescription": "Wayzerr uses System Events to click and type on your Mac, only when you let a bot control it.",
        "NSDownloadsFolderUsageDescription": "Wayzerr saves pictures you choose to download here. It only looks for an update file here when you press Check for updates and the update server cannot be reached.",
        "NSLocalNetworkUsageDescription": "Wayzerr lets your phone connect to this Mac over your Wi-Fi when you switch on Phone.",
        "NSCameraUsageDescription": "Wayzerr does not use the camera.",
        "NSBluetoothAlwaysUsageDescription": "Wayzerr does not use Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "Wayzerr does not use Bluetooth.",
        "NSAudioCaptureUsageDescription": "Wayzerr does not record the sound of other apps."
      },
      "identity": "Developer ID Application: YOUR NAME (TEAMID)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "buildVersion": "202610171202",
    "dmg": {
      "artifactName": "Wayzerr.dmg",
      "background": "build/dmg-background.tiff",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 430,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 580,
        "height": 460
      }
    },
    "afterPack": "scripts/after-pack.js",
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Wayzerr-Setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "wayzerr",
      "maintainer": "Wayzerr <hello@wayzerr.com>",
      "artifactName": "Wayzerr-${version}-linux-${arch}.${ext}",
      "synopsis": "AI bots with memory and their own computer"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "resedit": "^1.7.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir --arm64 -p never",
    "preflight": "bash scripts/preflight.sh dist/mac-arm64/Wayzerr.app"
  },
  "homepage": "https://wayzerr.com"
}
